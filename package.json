{
	"name": "nacc-home",
	"version": "0.1.0",
	"description": "National Aquatic Connectivity Collaborative",
	"author": "Brendan C. Ward <bcward@astutespruce.com>",
	"license": "MIT",
	"private": false,
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "eslint .",
		"predeploy": "npm run build",
		"deploy": "rm -rf /var/www/nacc-home/* && cp -r public/* /var/www/nacc-home"
	},
	"dependencies": {
		"@internationalized/date": "^3.12.3",
		"@sentry/svelte": "^10.71.0",
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/enhanced-img": "^0.11.0",
		"@sveltejs/kit": "^2.70.3",
		"@sveltejs/vite-plugin-svelte": "^7.3.0",
		"@tailwindcss/vite": "^4.3.3",
		"@types/node": "^26",
		"bits-ui": "^2.19.0",
		"clsx": "^2.1.1",
		"dotenv": "^17.4.2",
		"globals": "^17.11.0",
		"svelte": "^5.56.10",
		"svelte-check": "^4.7.6",
		"tailwind-merge": "^3.6.0",
		"tailwind-variants": "^3.3.1",
		"tailwindcss": "^4.3.3",
		"tw-animate-css": "^1.4.0",
		"typescript": "^7.0.2",
		"vite": "^8.2.2"
	},
	"devDependencies": {
		"@eslint/compat": "^2.1.0",
		"@eslint/js": "^10.0.1",
		"@lucide/svelte": "^1.34.0",
		"eslint": "^10.9.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.23.0",
		"prettier": "^3.9.6",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"typescript-eslint": "^8.68.0"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/astutespruce/nacc-home"
	},
	"bugs": {
		"url": "https://github.com/astutespruce/nacc-home/issues"
	}
}
