{
	"name": "nacc-home",
	"version": "0.1.0",
	"description": "National Aquatic Connectivity Collaborative",
	"author": "Brendan C. Ward <bcward@astutespruce.com>",
	"license": "MIT",
	"private": false,
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"format": "oxfmt .",
		"lint": "oxfmt --check . && oxlint && eslint .",
		"knip": "knip",
		"predeploy": "npm run build",
		"deploy": "rm -rf /var/www/nacc-home/* && cp -r public/* /var/www/nacc-home"
	},
	"imports": {
		"#lib/*": "./src/lib/*",
		"#images/*": "./src/lib/assets/images/*"
	},
	"dependencies": {
		"@internationalized/date": "^3.12.4",
		"@sentry/svelte": "^11.10.0",
		"@sveltejs/adapter-static": "^4.0.0",
		"@sveltejs/enhanced-img": "^1.0.0",
		"@sveltejs/kit": "^3.1.0",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tailwindcss/vite": "^4.3.3",
		"@types/node": "^26",
		"@typescript/native": "npm:typescript@^7.0.2",
		"bits-ui": "^2.20.2",
		"clsx": "^2.1.1",
		"dotenv": "^18.0.9",
		"globals": "^17.13.0",
		"svelte": "^5.57.3",
		"svelte-check": "^4.7.7",
		"tailwind-merge": "^3.7.0",
		"tailwind-variants": "^3.3.1",
		"tailwindcss": "^4.3.3",
		"tw-animate-css": "^1.4.0",
		"typescript": "npm:@typescript/typescript6@^6.0.2",
		"vite": "^8.3.5"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@lucide/svelte": "^1.63.0",
		"@sveltejs/load-config": "^0.2.3",
		"eslint": "^10.13.0",
		"eslint-plugin-oxlint": "^1.90.0",
		"eslint-plugin-svelte": "^3.23.1",
		"knip": "^6.43.0",
		"oxfmt": "^0.75.0",
		"oxlint": "^1.90.0",
		"typescript-eslint": "^8.72.1"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/astutespruce/nacc-home"
	},
	"bugs": {
		"url": "https://github.com/astutespruce/nacc-home/issues"
	}
}
